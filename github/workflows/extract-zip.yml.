name: Extract supplier agent ZIP

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract project files
        run: |
          python - <<'PY'
          import zipfile
          from pathlib import Path

          archive = Path("supplier-agent-pro.zip")
          if not archive.exists():
              raise SystemExit("ZIP file not found in repository root")

          with zipfile.ZipFile(archive) as z:
              names = z.namelist()
              roots = {
                  n.split("/")[0] for n in names if "/" in n
              }
              strip = len(roots) == 1 and all(
                  n.startswith(next(iter(roots)) + "/") for n in names
              )
              root = next(iter(roots)) if strip else None

              for name in names:
                  p = Path(name)
                  parts = p.parts
                  if root and parts and parts[0] == root:
                      parts = parts[1:]
                  if not parts:
                      continue
                  target = Path(*parts)
                  if target.is_absolute() or ".." in target.parts:
                      raise SystemExit("Unsafe path in ZIP")
                  if target.exists():
                      continue
                  if name.endswith("/"):
                      target.mkdir(parents=True, exist_ok=True)
                  else:
                      target.parent.mkdir(parents=True, exist_ok=True)
                      target.write_bytes(z.read(name))
          PY

      - name: Commit extracted files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git diff --cached --quiet || git commit -m "Extract supplier agent project"
          git push
